# DITTO_LLM_MODE=mock uses fixed responses (schema-conformant) — no API key needed.
# DITTO_LLM_MODE=live calls OpenAI.
# 코드 기본값(이 변수 자체를 안 정해두면)은 mock이 아니라 live다 — env var 설정을 깜빡한
# 배포가 조용히 가짜 응답만 내보내는 것보다, 키가 없어 바로 죽는 게 안전하다. 로컬 개발은
# 아래처럼 이 파일에서 mock을 명시해서 그 경로는 그대로 유지한다.
DITTO_LLM_MODE=mock

OPENAI_API_KEY=
# 2026-08-17 기준 이 계정은 결제 이력이 없는 Free tier로 확정(대시보드 청구→신용
# 보조금 확인 결과 잔액은 2026-07-30 지급된 $100 무료 grant였고, tier 승급은
# "total credit purchases" 기준이라 grant를 아무리 써도 안 오름 — 결제는 안 하기로
# 함, docs/survey-results-analysis.md 15절). 모델별 무료 티어 한도가 서로 다름:
# gpt-4.1은 RPD가 아니라 RPM 3/min이 병목이고, o3-mini는 RPD 150/day로 다른 모델
# (50/day)보다 3배 넉넉함. 처음엔 12케이스 쉬운 부분집합에서 gpt-4o-mini/gpt-4.1-mini가
# precision 동률 1위였지만, self-consistency(만장일치, n=3)를 프로덕션에 채택한 뒤
# **36케이스 전체**로 o3-mini를 재검증하니 recall=0.857/precision=0.750로 이번
# 세션 최고 균형 결과가 나와 o3-mini로 최종 변경(docs/survey-results-analysis.md
# 13-1/16절). RPD 여유도 훨씬 크다는 것도 이 선택을 뒷받침함. RAG(동적 few-shot)도
# 36케이스 전체에서 recall=1.000/precision=0.875까지 올리는 것처럼 보였으나,
# golden.json ambiguous 케이스의 76%가 RAG로 자기 자신의 원본 판단기준표 항목을
# few-shot으로 그대로 받아오는 유출 문제가 확인돼(17-4절) 기본값 False로 되돌림
# — 최종 프로덕션 기본값 = o3-mini + self-consistency만(RAG는 옵션으로 남김).
DITTO_OPENAI_MODEL=o3-mini
DITTO_TRANSLATION_MODEL=gpt-4o-mini

# Where the LangGraph checkpointer's SQLite file lives (thread/interrupt state only —
# not domain data, that's the FastAPI teammate's DB).
DITTO_CHECKPOINT_DB=./ditto_checkpoints.db

# Spring backend and this internal-only service must share this value.
DITTO_INTERNAL_API_KEY=replace-this-with-a-random-internal-secret
